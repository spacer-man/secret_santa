# Локальная разработка через туннель: cp .env.dev.example .env.dev, затем ./scripts/dev-tunnel.sh
# Никогда не коммитьте .env.dev!

# Токен ОТДЕЛЬНОГО тестового бота (@BotFather → /newbot). Не боевого:
# скрипт переставляет ему вебхук и кнопку меню на временный адрес туннеля.
BOT_TOKEN=123456:replace_with_test_bot_token
# Ваш Telegram ID (узнать: @userinfobot) — будете модератором пожеланий
WISH_VALIDATE_TG_IDS=111111111

# Необязательно:
# TUNNEL=cloudflared           # cloudflared | ngrok | ssh (по умолчанию — первый найденный)
# WEB_PORT=4200
# API_PORT=8000                # если порт занят другим процессом
# WEBHOOK_PORT=8080            # порт вебхука бота
# DB_URL=postgresql+asyncpg://santa:santa@localhost:5432/secret_santa   # по умолчанию SQLite в .dev/santa.db
# STATE_STORAGE_REDIS_URL=redis://localhost:6379/0                      # по умолчанию состояния в памяти
# AUTHOR_SUPPORT_LINK=https://t.me/your_username
