# Скопируйте в .env (cp .env.example .env) и заполните. Никогда не коммитьте .env!

# --- Домен ---
# Ваш домен (A-запись должна указывать на IP сервера), без https://
DOMAIN=santa.example.com
# Публичный адрес сайта / Mini App
WEBAPP_URL=https://santa.example.com

# --- База данных (Postgres) ---
DB_USER=santa
DB_PASSWORD=change_me_db_password
DB_NAME=secret_santa

# --- Redis (хранилище состояний бота) ---
STATE_STORAGE_PASSWORD=change_me_redis_password

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:replace_with_real_token
# Секрет вебхука: любая случайная строка (например: openssl rand -hex 24)
WEBHOOK_SECRET=change_me_random_string
# Telegram ID модераторов пожеланий (через запятую)
WISH_VALIDATE_TG_IDS=111111111,222222222
# Ссылка для поддержки автора
AUTHOR_SUPPORT_LINK=https://t.me/your_username

# --- Вход без Telegram и уведомления (всё необязательно: пусто — выключено) ---
# Почта: коды входа и письмо с подарком в полночь. Подойдёт любой SMTP
# (Brevo / Resend / Mailgun — бесплатных лимитов хватает, или почта на своём домене)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Тайный Санта <santa@example.com>
# true — TLS сразу (порт 465), false — STARTTLS (порт 587)
SMTP_SSL=false
# Вход через Google: Client ID (тип «Web application») из Google Cloud Console
GOOGLE_CLIENT_ID=
# Push-уведомления: ключи VAPID, создать —
#   docker compose run --rm api python -m services.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:santa@example.com

